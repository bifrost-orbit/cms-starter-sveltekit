{
	"name": "cms-starter-sveltekit",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "node build",
		"cms:types": "cms-orbit generate --out src/lib/cms-types.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@bifrost-orbit-cms/sdk": "^0.12.0"
	}
}
